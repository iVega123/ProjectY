{
  "Swagger": {
    "Enabled": false
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Idempotency": {
    "ClaimTtl": "00:01:00",
    "ResponseTtl": "1.00:00:00",
    "MaximumKeyLength": 200
  },
  "MongoDbSettings": {
    "DatabaseName": "RentalOperationsDB"
  },
  "Messaging": {
    "Inbox": {
      "ClaimLease": "00:01:00",
      "RetentionPeriod": "7.00:00:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "VirtualHost": "projecty-rental",
    "LicenceUpdateQueueName": "licence_update_queue",
    "LicenceUpdatePoisonQueueName": "licence_update_poison_queue"
  },
  "RiderManagerSettings": {
    "BaseUrl": "http://rider-manager:8000/"
  },
  "MotoHubSettings": {
    "BaseUrl": "http://moto-hub:8100/"
  },
  "Jwt": {
    "Issuer": "projecty.auth-gate",
    "Audience": "projecty.rental-operations"
  },
  "ApplicationName": "rental-operations",
  "ElasticSearchURL": "http://elasticsearch:9200",
  "AllowedHosts": "*"
}
