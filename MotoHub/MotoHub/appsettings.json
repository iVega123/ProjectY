{
  "Swagger": {
    "Enabled": false
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Idempotency": {
    "ResponseTtl": "1.00:00:00",
    "MaximumKeyLength": 200
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "VirtualHost": "projecty-rental",
    "LicenceUpdateQueueName": "licence_update_queue"
  },
  "RentalOperationsSettings": {
    "BaseUrl": "http://rental-operations:8200/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "projecty.auth-gate",
    "Audience": "projecty.moto-hub"
  },
  "ApplicationName": "moto-hub",
  "ElasticSearchURL": "http://elasticsearch:9200",
  "AllowedHosts": "*"
}
