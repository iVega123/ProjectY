{
  "Swagger": {
    "Enabled": false
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Idempotency": {
    "ResponseTtl": "1.00:00:00",
    "MaximumKeyLength": 200
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "VirtualHost": "projecty-rider",
    "RiderInfoQueueName": "cmd.rider.register",
    "ImageStreamQueueName": "cmd.rider.store-document"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "projecty.auth-gate",
    "Audiences": {
      "AuthGate": "projecty.auth-gate",
      "MotoHub": "projecty.rental-core",
      "RiderManager": "projecty.rider-manager",
      "RentalOperations": "projecty.rental-core"
    }
  },
  "ApplicationName": "auth-gate",
  "AllowedHosts": "*"
}
