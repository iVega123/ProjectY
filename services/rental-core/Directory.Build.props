<Project>
  <!--
    Code analysis for RentalCore and its tests. latest-recommended adds the CA
    rules Microsoft marks as recommended on top of the default set. What it found
    when it was turned on was fixed; the few checks left off say why, in
    analyzers.globalconfig and RentalCoreTests.csproj.

    In CI (GitHub Actions sets CI=true) a warning fails the build, so a new one
    cannot land unnoticed. Locally they stay warnings, so an unfinished change
    still builds. NuGet audit warnings do not fail it: a newly published advisory
    would otherwise fail every open pull request at once, whatever it changed.
    Dependabot and the image scans report those.
  -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)analyzers.globalconfig" />
  </ItemGroup>
</Project>
