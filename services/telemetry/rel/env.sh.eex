#!/bin/sh
# BEAM distribution, so Presence and the metrics:global broadcast reach clients
# on every replica (ADR 0019, #194). Kubernetes hands each pod its IP through
# the downward API; the node is named after it, and DNS_CLUSTER_QUERY finds the
# others through the headless service. Without POD_IP -- compose, a laptop --
# the release keeps its default short name and runs alone.
if [ -n "$POD_IP" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="telemetry@${POD_IP}"
fi
