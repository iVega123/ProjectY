{
  "Swagger": {
    "Enabled": false
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Idempotency": {
    "ResponseTtl": "1.00:00:00",
    "MaximumKeyLength": 200
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "VirtualHost": "projecty-rider",
    "RiderInfoQueueName": "rider_info_queue",
    "ImageStreamQueueName": "image_stream_queue",
    "RiderPoisonStreamQueueName": "rider_info_poison_queue"
  },
  "MinIO": {
    "Endpoint": "minio",
    "BucketName": "my-bucket"
  },
  "Messaging": {
    "Inbox": {
      "RetentionPeriod": "7.00:00:00",
      "SweepInterval": "01:00:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GatewayIdentity": {
    "SigningKeyId": "local-v1",
    "MaximumAgeSeconds": 30,
    "ClockSkewSeconds": 5
  },
  "ApplicationName": "rider-manager",
  "AllowedHosts": "*"
}
