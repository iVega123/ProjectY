{
  "Swagger": {
    "Enabled": false
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "VirtualHost": "projecty-rider",
    "RiderInfoQueueName": "rider_info_queue",
    "ImageStreamQueueName": "image_stream_queue",
    "RiderPoisonStreamQueueName": "rider_info_poison_queue"
  },
  "MinIO": {
    "Endpoint": "minio",
    "BucketName": "my-bucket"
  },
  "Messaging": {
    "Inbox": {
      "RetentionPeriod": "7.00:00:00",
      "SweepInterval": "01:00:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "projecty.auth-gate",
    "Audience": "projecty.rider-manager"
  },
  "ApplicationName": "rider-manager",
  "ElasticSearchURL": "http://elasticsearch:9200",
  "AllowedHosts": "*"
}
